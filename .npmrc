# figma-managed npm registry config start
@make-kits:registry=https://registry.figma.com/npm/2eef41b1-38ba-4b17-b136-14da6b079d6d/registry/
# figma-managed npm registry config end

# Level CI (Level Access) private registry.
#
# Only the registry mapping lives here. The matching _authToken deliberately
# does NOT, because pnpm refuses to expand environment variables in registry
# credentials read from a project-level .npmrc — that file is committed, so
# expanding it could leak the token to an attacker-controlled registry. A
# `_authToken=${CLOUDSMITH_TOKEN}` line here is silently ignored and yields a
# 401 at install time.
#
# Supply the token from a trusted location instead:
#   pnpm config set --global "//npm.levelaccess.net/level-ci/:_authToken" <token>
# CI does this in .github/workflows/build.yml before installing.
@level-ci:registry=https://npm.levelaccess.net/level-ci/
