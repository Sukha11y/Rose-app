# figma-managed npm registry config start
@make-kits:registry=https://registry.figma.com/npm/2eef41b1-38ba-4b17-b136-14da6b079d6d/registry/
# figma-managed npm registry config end

# Level CI (Level Access) private registry.
# The auth token is read from the CLOUDSMITH_TOKEN environment variable at
# install time — never hard-code the value here, this file is committed.
@level-ci:registry=https://npm.levelaccess.net/level-ci/
//npm.levelaccess.net/level-ci/:_authToken=${CLOUDSMITH_TOKEN}
